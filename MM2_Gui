-- StarterGui.MM2_Gui.MainFrame.MM2_Autofarm.LocalScript
local function C_1b()
local script = G2L["1b"];
	-- ==========================================
	-- MM2_AutoFarm (РАБОЧАЯ ВЕРСИЯ)
	-- ==========================================
	local button = script.Parent
	local player = game.Players.LocalPlayer
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local TweenService = game:GetService("TweenService")
	
	local isActive = false
	local farmConnection = nil
	local safePoint = nil
	local currentTarget = nil
	local currentTween = nil
	local isMoving = false
	
	-- ====== ОСТАНОВКА ТВИНА ======
	local function stopTween()
		if currentTween then
			pcall(function() currentTween:Cancel() end)
			currentTween = nil
		end
		isMoving = false
	end
	
	-- ====== ПРОВЕРКА РАУНДА ======
	local function isRoundActive()
		local mainGui = player.PlayerGui:FindFirstChild("MainGUI")
		if not mainGui then return false end
		local gameFrame = mainGui:FindFirstChild("Game")
		if not gameFrame then return false end
		if gameFrame:FindFirstChild("Timer") and gameFrame.Timer.Visible then
			return true
		end
		if player:GetAttribute("Alive") == true then
			return true
		end
		return false
	end
	
	-- ====== ПОИСК КАРТЫ ======
	local function findMap()
		for _, v in workspace:GetDescendants() do
			if v.Name == "Spawns" and v.Parent and v.Parent.Name ~= "Lobby" then
				return v.Parent
			end
		end
		return nil
	end
	
	-- ====== ПОИСК КОНТЕЙНЕРА ======
	local function findCoinContainer()
		local map = findMap()
		if map then
			return map:FindFirstChild("CoinContainer")
		end
		return nil
	end
	
	-- ====== ПОИСК УБИЙЦЫ ======
	local function findMurderer()
		for _, plr in pairs(Players:GetPlayers()) do
			if plr ~= player then
				if plr.Backpack:FindFirstChild("Knife") then
					return plr
				end
				if plr.Character and plr.Character:FindFirstChild("Knife") then
					return plr
				end
			end
		end
		return nil
	end
	
	-- ====== ПРОВЕРКА МОНЕТЫ ======
	local function isCoinValid(coin)
		if not coin then return false end
		if not coin.Parent then return false end
		if coin:FindFirstChild("TouchInterest") then
			return true
		end
		return false
	end
	
	-- ====== ПОЛУЧИТЬ ВСЕ МОНЕТЫ ======
	local function getCoins(container)
		local coins = {}
		if not container then return coins end
		for _, coin in pairs(container:GetChildren()) do
			if isCoinValid(coin) then
				table.insert(coins, coin)
			end
		end
		return coins
	end
	
	-- ====== ПОИСК БЛИЖАЙШЕЙ МОНЕТЫ ======
	local function findNearestCoin(coins, position, murdererPos)
		local nearest = nil
		local nearestDist = math.huge
		for _, coin in pairs(coins) do
			local coinPos = coin.Position
			if murdererPos then
				local distToMurderer = (coinPos - murdererPos).Magnitude
				if distToMurderer < 30 then
					continue
				end
			end
			local dist = (position - coinPos).Magnitude
			if dist < nearestDist then
				nearestDist = dist
				nearest = coin
			end
		end
		return nearest, nearestDist
	end
	
	-- ====== ПОЛЕТ ======
	local function flyTo(targetPos)
		local char = player.Character
		if not char then return false end
	
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then return false end
	
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then return false end
	
		local distance = (hrp.Position - targetPos).Magnitude
	
		if distance < 5 then
			return true
		end
	
		local speed = 20
		local duration = distance / speed
		duration = math.max(duration, 0.3)
		duration = math.min(duration, 2.5)
	
		stopTween()
		isMoving = true
	
		local tweenInfo = TweenInfo.new(
			duration,
			Enum.EasingStyle.Linear,
			Enum.EasingDirection.Out
		)
	
		currentTween = TweenService:Create(hrp, tweenInfo, {
			Position = targetPos
		})
	
		local completed = false
		currentTween.Completed:Connect(function()
			completed = true
			isMoving = false
		end)
	
		currentTween:Play()
	
		local timeout = tick() + duration + 1
		repeat
			task.wait()
	
			if humanoid.Health <= 0 then
				stopTween()
				return false
			end
	
			if currentTarget and not isCoinValid(currentTarget) then
				stopTween()
				return false
			end
	
			if tick() > timeout then
				stopTween()
				return false
			end
	
		until completed == true
	
		currentTween = nil
		isMoving = false
		return true
	end
	
	-- ====== ПОДОБРАТЬ МОНЕТУ ======
	local function pickCoin(coin)
		if not coin or not isCoinValid(coin) then return false end
		local char = player.Character
		if not char then return false end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then return false end
		pcall(function()
			firetouchinterest(hrp, coin, 0)
			firetouchinterest(hrp, coin, 1)
		end)
		return true
	end
	
	-- ====== ВЕРНУТЬСЯ В СЕЙВ ======
	local function goToSafe()
		if not safePoint then return end
		local char = player.Character
		if not char then return end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
		local dist = (hrp.Position - safePoint).Magnitude
		if dist < 5 then return end
		flyTo(safePoint)
	end
	
	-- ====== ОСНОВНОЙ ЦИКЛ ======
	local function farmTick()
		if not isRoundActive() then
			return
		end
	
		local char = player.Character
		if not char then return end
	
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
	
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then return end
	
		local murderer = findMurderer()
		local murdererPos = nil
		if murderer and murderer.Character then
			local mhrp = murderer.Character:FindFirstChild("HumanoidRootPart")
			if mhrp then
				murdererPos = mhrp.Position
			end
		end
	
		if murdererPos and safePoint then
			local dist = (hrp.Position - murdererPos).Magnitude
			if dist < 30 then
				if not isMoving then
					goToSafe()
				end
				return
			end
		end
	
		if isMoving then
			return
		end
	
		local container = findCoinContainer()
		if not container then return end
	
		local coins = getCoins(container)
		if #coins == 0 then
			return
		end
	
		local nearest, dist = findNearestCoin(coins, hrp.Position, murdererPos)
	
		if not nearest then
			return
		end
	
		currentTarget = nearest
	
		local success = flyTo(nearest.Position)
	
		if success then
			pickCoin(nearest)
			currentTarget = nil
		end
	end
	
	-- ====== ЗАПУСК ======
	local function startFarming()
		if isActive then return end
	
		local char = player.Character
		if not char then return end
	
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if hrp then
			safePoint = hrp.Position
		end
	
		isActive = true
	
		if farmConnection then
			farmConnection:Disconnect()
			farmConnection = nil
		end
	
		farmConnection = RunService.Heartbeat:Connect(function()
			if not isActive then
				if farmConnection then
					farmConnection:Disconnect()
					farmConnection = nil
				end
				return
			end
			farmTick()
		end)
	
		print("🟢 MM2 AutoFarm: ВКЛ")
	end
	
	-- ====== ОСТАНОВКА ======
	local function stopFarming()
		isActive = false
	
		if farmConnection then
			farmConnection:Disconnect()
			farmConnection = nil
		end
	
		stopTween()
	
		local char = player.Character
		if char then
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hrp then
				hrp.Velocity = Vector3.zero
				hrp.RotVelocity = Vector3.zero
			end
		end
	
		currentTarget = nil
		print("🔴 MM2 AutoFarm: ВЫКЛ")
	end
	
	-- ====== КНОПКА ======
	button.MouseButton1Click:Connect(function()
		if isActive then
			stopFarming()
		else
			startFarming()
		end
	end)
	
	-- ====== РЕСПАВН ======
	player.CharacterAdded:Connect(function()
		task.wait(0.5)
		if isActive then
			local char = player.Character
			if char then
				local hrp = char:FindFirstChild("HumanoidRootPart")
				if hrp then
					safePoint = hrp.Position
				end
			end
		end
	end)
	
	print("✅ MM2_AutoFarm загружена!")
end;
