local function C_16()
local script = G2L["16"];
	-- ==========================================
	-- MM2_ESP (СТАБИЛЬНАЯ ВЕРСИЯ)
	-- ==========================================
	local button = script.Parent
	local player = game.Players.LocalPlayer
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local RunService = game:GetService("RunService")
	local Players = game:GetService("Players")
	
	local isActive = false
	local updateLoop = nil
	local espObjects = {}
	
	local COLORS = {
		Murderer = Color3.fromRGB(255, 0, 0),
		Sheriff = Color3.fromRGB(0, 100, 255),
		Hero = Color3.fromRGB(255, 200, 0),
		Default = Color3.fromRGB(0, 255, 0)
	}
	
	-- ====== ПОЛУЧЕНИЕ РОЛЕЙ ======
	local function fetchRoles()
		local getPlayerData = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
		if not getPlayerData then return {} end
	
		local success, data = pcall(function()
			return getPlayerData:InvokeServer()
		end)
	
		if not success or not data then return {} end
	
		local roles = {}
		for name, info in pairs(data) do
			roles[name] = info.Role
		end
		return roles
	end
	
	-- ====== СОЗДАНИЕ ESP ======
	local function createESP(playerObj, role)
		local char = playerObj.Character
		if not char then return nil end
	
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then return nil end
	
		local color = COLORS[role] or COLORS.Default
	
		local highlight = Instance.new("Highlight")
		highlight.Parent = char
		highlight.FillColor = color
		highlight.FillTransparency = 0.5
		highlight.OutlineColor = color
		highlight.OutlineTransparency = 0
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	
		local billboard = Instance.new("BillboardGui")
		billboard.Parent = hrp
		billboard.Size = UDim2.new(0, 200, 0, 30)
		billboard.StudsOffset = Vector3.new(0, 2.5, 0)
		billboard.AlwaysOnTop = true
	
		local textLabel = Instance.new("TextLabel")
		textLabel.Parent = billboard
		textLabel.Size = UDim2.new(1, 0, 1, 0)
		textLabel.BackgroundTransparency = 1
		textLabel.Text = playerObj.Name
		textLabel.TextColor3 = color
		textLabel.TextSize = 16
		textLabel.Font = Enum.Font.GothamBold
		textLabel.TextStrokeTransparency = 0.3
		textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	
		if role and role ~= "" then
			local roleNames = {
				Murderer = "🔴 Убийца",
				Sheriff = "🔵 Шериф",
				Hero = "🟡 Герой"
			}
			textLabel.Text = playerObj.Name .. " (" .. (roleNames[role] or role) .. ")"
		end
	
		return {highlight = highlight, billboard = billboard, text = textLabel}
	end
	
	-- ====== УДАЛЕНИЕ ВСЕГО ESP ======
	local function clearESP()
		for name, data in pairs(espObjects) do
			if data.highlight and data.highlight.Parent then
				data.highlight:Destroy()
			end
			if data.billboard and data.billboard.Parent then
				data.billboard:Destroy()
			end
			espObjects[name] = nil
		end
		espObjects = {}
	end
	
	-- ====== ОБНОВЛЕНИЕ ESP ======
	local function updateESP()
		if not isActive then
			clearESP()
			return
		end
	
		local roles = fetchRoles() or {}
	
		for _, plr in pairs(Players:GetPlayers()) do
			if plr == player then continue end
	
			if not plr.Character or not plr.Character:FindFirstChild("HumanoidRootPart") then
				if espObjects[plr.Name] then
					if espObjects[plr.Name].highlight then
						espObjects[plr.Name].highlight:Destroy()
					end
					if espObjects[plr.Name].billboard then
						espObjects[plr.Name].billboard:Destroy()
					end
					espObjects[plr.Name] = nil
				end
				continue
			end
	
			if espObjects[plr.Name] then
				local role = roles[plr.Name]
				local color = COLORS[role] or COLORS.Default
				if espObjects[plr.Name].highlight then
					espObjects[plr.Name].highlight.FillColor = color
					espObjects[plr.Name].highlight.OutlineColor = color
				end
				if espObjects[plr.Name].text then
					espObjects[plr.Name].text.TextColor3 = color
					if role and role ~= "" then
						local roleNames = {
							Murderer = "🔴 Убийца",
							Sheriff = "🔵 Шериф",
							Hero = "🟡 Герой"
						}
						espObjects[plr.Name].text.Text = plr.Name .. " (" .. (roleNames[role] or role) .. ")"
					else
						espObjects[plr.Name].text.Text = plr.Name
					end
				end
				continue
			end
	
			local role = roles[plr.Name]
			local esp = createESP(plr, role)
			if esp then
				espObjects[plr.Name] = esp
			end
		end
	end
	
	-- ====== ЗАПУСК ======
	local function startESP()
		if isActive then return end
		isActive = true
		print("🟢 MM2 ESP ВКЛЮЧЕН!")
	
		if updateLoop then
			updateLoop:Disconnect()
			updateLoop = nil
		end
	
		updateESP()
	
		updateLoop = RunService.Heartbeat:Connect(function()
			if isActive then
				updateESP()
			end
		end)
	end
	
	-- ====== ОСТАНОВКА ======
	local function stopESP()
		isActive = false
	
		if updateLoop then
			updateLoop:Disconnect()
			updateLoop = nil
		end
	
		clearESP()
		print("🔴 MM2 ESP ВЫКЛЮЧЕН!")
	end
	
	-- ====== ПЕРЕКЛЮЧЕНИЕ ======
	button.MouseButton1Click:Connect(function()
		if isActive then
			stopESP()
		else
			startESP()
		end
	end)
	
	print("✅ MM2_ESP загружена!")
end;
