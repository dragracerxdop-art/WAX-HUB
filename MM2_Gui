	-- ==========================================
	local button = script.Parent
	local runService = game:GetService("RunService")
	
	local isEnabled = false
	local highlight = nil
	local lastCheck = 0
	local connection = nil
	
	-- ===== ПОИСК ПИСТОЛЕТА НА ЗЕМЛЕ =====
	local function findGun()
		for _, obj in pairs(workspace:GetDescendants()) do
			if obj.Name == "GunDrop" then
				return obj
			end
		end
		return nil
	end
	
	-- ===== ОБНОВЛЕНИЕ =====
	local function update()
		if not isEnabled then
			if highlight then
				highlight:Destroy()
				highlight = nil
			end
			return
		end
	
		local now = tick()
		if now - lastCheck < 2 then return end
		lastCheck = now
	
		local gun = findGun()
	
		if gun then
			if not highlight or highlight.Parent ~= gun then
				if highlight then highlight:Destroy() end
				highlight = Instance.new("Highlight")
				highlight.Name = "GunHighlight"
				highlight.FillColor = Color3.fromRGB(255, 215, 0)
				highlight.FillTransparency = 0.3
				highlight.OutlineColor = Color3.fromRGB(255, 215, 0)
				highlight.OutlineTransparency = 0
				highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				highlight.Adornee = gun
				highlight.Parent = gun
				print("🔫 Пистолет подсвечен!")
			end
		else
			if highlight then
				highlight:Destroy()
				highlight = nil
			end
		end
	end
	
	-- ===== ПЕРЕКЛЮЧЕНИЕ =====
	local function toggle()
		isEnabled = not isEnabled
	
		if isEnabled then
			lastCheck = 0
			if connection then
				connection:Disconnect()
				connection = nil
			end
			connection = runService.Heartbeat:Connect(update)
			update()
			print("🔫 GunESP включён!")
		else
			if connection then
				connection:Disconnect()
				connection = nil
			end
			if highlight then
				highlight:Destroy()
				highlight = nil
			end
			print("🔫 GunESP выключен!")
		end
	end
	
	button.MouseButton1Click:Connect(toggle)
	
