local function C_10()
local script = G2L["10"];
	-- ==========================================
	-- AIMBOT (ВКЛ/ВЫКЛ)
	-- ==========================================
	local button = script.Parent
	local player = game.Players.LocalPlayer
	local RunService = game:GetService("RunService")
	local UserInputService = game:GetService("UserInputService")
	
	local isEnabled = false
	local loop = nil
	local teamCheck = false
	local fov = 150
	local smoothing = 1
	
	_G.AimToggleKey = _G.AimToggleKey or nil
	
	-- FOV КРУГ
	local FOVring = Drawing.new("Circle")
	FOVring.Visible = false
	FOVring.Thickness = 1.5
	FOVring.Radius = fov
	FOVring.Transparency = 1
	FOVring.Color = Color3.fromRGB(255, 128, 128)
	FOVring.Position = workspace.CurrentCamera.ViewportSize / 2
	
	-- ===== ПОИСК БЛИЖАЙШЕГО =====
	local function getClosest(cframe)
		local ray = Ray.new(cframe.Position, cframe.LookVector).Unit
		local target = nil
		local mag = math.huge
	
		for _, v in pairs(game.Players:GetPlayers()) do
			if v.Character and v.Character:FindFirstChild("Head") and v.Character:FindFirstChild("Humanoid") and v.Character:FindFirstChild("HumanoidRootPart") and v ~= player and (v.Team ~= player.Team or (not teamCheck)) then
				local magBuf = (v.Character.Head.Position - ray:ClosestPoint(v.Character.Head.Position)).Magnitude
				if magBuf < mag then
					mag = magBuf
					target = v
				end
			end
		end
	
		return target
	end
	
	-- ===== ЗАПУСК =====
	local function startAim()
		if loop then return end
	
		loop = RunService.RenderStepped:Connect(function()
			local cam = workspace.CurrentCamera
			local zz = cam.ViewportSize / 2
			FOVring.Position = zz
	
			if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end
	
			local curTar = getClosest(cam.CFrame)
			if not curTar then return end
	
			local ssHeadPoint = cam:WorldToScreenPoint(curTar.Character.Head.Position)
			ssHeadPoint = Vector2.new(ssHeadPoint.X, ssHeadPoint.Y)
	
			if (ssHeadPoint - zz).Magnitude < fov then
				cam.CFrame = cam.CFrame:Lerp(
					CFrame.new(cam.CFrame.Position, curTar.Character.Head.Position),
					smoothing
				)
			end
		end)
	end
	
	-- ===== ОСТАНОВКА =====
	local function stopAim()
		if loop then
			loop:Disconnect()
			loop = nil
		end
		FOVring.Visible = false
	end
	
	-- ===== ТОГГЛ =====
	local function toggleAim()
		isEnabled = not isEnabled
	
		if isEnabled then
			print("🎯 АИМ: ВКЛ")
			FOVring.Visible = true
			startAim()
		else
			print("🎯 АИМ: ВЫКЛ")
			stopAim()
		end
	end
	
	-- ===== КНОПКА =====
	button.MouseButton1Click:Connect(toggleAim)
	
	-- ===== БИНД =====
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.UserInputType == Enum.UserInputType.Keyboard and _G.AimToggleKey and input.KeyCode == _G.AimToggleKey then
			toggleAim()
		end
	end)
	
	workspace:WaitForChild("CurrentCamera").GetPropertyChangedSignal("ViewportSize"):Connect(function()
		FOVring.Position = workspace.CurrentCamera.ViewportSize / 2
	end)
	
	print("✅ Aimbot загружен!")
end;
task.spawn(C_10);
