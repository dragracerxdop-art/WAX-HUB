local function C_1e()
local script = G2L["1e"];
	-- ==========================================
	-- MM2_DeleteGui (УДАЛИТЬ MM2 GUI ПОЛНОСТЬЮ)
	-- ==========================================
	local button = script.Parent
	local player = game.Players.LocalPlayer
	
	button.MouseButton1Click:Connect(function()
		local playerGui = player:WaitForChild("PlayerGui")
		local mm2Gui = playerGui:FindFirstChild("MM2_Gui")
	
		if not mm2Gui then
			print("❌ MM2_Gui не найден в PlayerGui!")
			game:GetService("StarterGui"):SetCore("SendNotification", {
				Title = "MM2 GUI",
				Text = "MM2 GUI не найден!",
				Duration = 2
			})
			return
		end
	
		print("🔄 Отключаем все функции MM2...")
	
		-- ===== 1. ОСТАНАВЛИВАЕМ ВСЕ ЛУПЫ И ФУНКЦИИ =====
		-- Проходим по всем скриптам в GUI и отключаем их
		for _, scriptObj in pairs(mm2Gui:GetDescendants()) do
			if scriptObj:IsA("LocalScript") then
				-- Отключаем скрипт (останавливаем его работу)
				pcall(function()
					scriptObj.Disabled = true
				end)
			end
		end
	
		-- ===== 2. ОЧИЩАЕМ ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ =====
		-- Сбрасываем все активные флаги
		_G.MM2_ESP_Active = nil
		_G.MM2_AutoFarm_Active = nil
		_G.MM2_KillAll_Active = nil
		_G.MM2_GunESP_Active = nil
		_G.MM2_ShowRoles_Active = nil
		_G.MM2_KillMurderer_Active = nil
	
		-- ===== 3. ОСТАНАВЛИВАЕМ ВСЕ СОЗДАННЫЕ ОБЪЕКТЫ (ESP, Highlight и т.д.) =====
		-- Удаляем Highlight у всех игроков
		for _, plr in pairs(game:GetService("Players"):GetPlayers()) do
			if plr.Character then
				for _, child in pairs(plr.Character:GetChildren()) do
					if child:IsA("Highlight") then
						child:Destroy()
					end
				end
				for _, child in pairs(plr.Character:GetDescendants()) do
					if child:IsA("BillboardGui") then
						child:Destroy()
					end
				end
			end
		end
	
		-- Удаляем подсветку пистолета
		for _, obj in pairs(workspace:GetDescendants()) do
			if obj.Name == "GunHighlight" then
				obj:Destroy()
			end
		end
	
		-- ===== 4. УДАЛЯЕМ GUI =====
		task.wait(0.2)  -- Даём время на отключение
		mm2Gui:Destroy()
		print("🗑️ MM2_Gui удалён из игры!")
	
		game:GetService("StarterGui"):SetCore("SendNotification", {
			Title = "MM2 GUI",
			Text = "MM2 GUI удалён! Все функции остановлены.",
			Duration = 3
		})
	end)
	
	print("✅ MM2_DeleteGui загружена!")
end;
