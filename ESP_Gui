-- StarterGui.ESP_Hub.MainFrame.ESP_Players.LocalScript
local function C_d()
local script = G2L["d"];
	-- ==========================================
	-- ESP_Players (ПОДСВЕТКА + ИМЯ + ДИСТАНЦИЯ + ЗДОРОВЬЕ)
	-- ==========================================
	local button = script.Parent
	local Players = game:GetService("Players")
	local LocalPlayer = Players.LocalPlayer
	local RunService = game:GetService("RunService")
	
	local isEnabled = false
	local espLoop = nil
	
	-- ===== СОЗДАНИЕ ПОДСВЕТКИ =====
	local function createHighlight(player)
		if player.Character and not player.Character:FindFirstChild("ESPHighlight") then
			local highlight = Instance.new("Highlight")
			highlight.Name = "ESPHighlight"
			highlight.FillColor = Color3.fromRGB(255, 0, 0)
			highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
			highlight.FillTransparency = 0.6
			highlight.OutlineTransparency = 0
			highlight.Adornee = player.Character
			highlight.Parent = player.Character
			highlight.Enabled = isEnabled
		end
	end
	
	-- ===== СОЗДАНИЕ ИМЕНИ НАД ГОЛОВОЙ =====
	local function createNameTag(player)
		if player.Character and player.Character:FindFirstChild("Head") and not player.Character.Head:FindFirstChild("NameTag") then
			local billboard = Instance.new("BillboardGui")
			billboard.Name = "NameTag"
			billboard.Adornee = player.Character.Head
			billboard.Size = UDim2.new(0, 130, 0, 25)
			billboard.StudsOffset = Vector3.new(0, 2, 0)
			billboard.AlwaysOnTop = true
			billboard.Parent = player.Character.Head
	
			local textLabel = Instance.new("TextLabel")
			textLabel.Name = "TagLabel"
			textLabel.Size = UDim2.new(1, 0, 1, 0)
			textLabel.BackgroundTransparency = 1
			textLabel.TextColor3 = Color3.new(1, 1, 1)
			textLabel.Font = Enum.Font.Cartoon
			textLabel.TextScaled = true
			textLabel.TextStrokeTransparency = 0.6
			textLabel.Text = ""
			textLabel.Parent = billboard
		end
	end
	
	-- ===== ОБНОВЛЕНИЕ ИМЕНИ =====
	local function updateNameTag(player)
		if player.Character and player.Character:FindFirstChild("Head") and player.Character.Head:FindFirstChild("NameTag") and player.Character:FindFirstChild("Humanoid") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("PrimaryPart") then
			local tag = player.Character.Head.NameTag.TagLabel
			local distance = (LocalPlayer.Character.PrimaryPart.Position - player.Character.PrimaryPart.Position).Magnitude
			local health = math.floor(player.Character.Humanoid.Health)
			tag.Text = player.Name .. " | " .. string.format("%.0f", distance) .. "m | ❤️" .. health
		end
	end
	
	-- ===== ОБНОВЛЕНИЕ ЦВЕТА ПОДСВЕТКИ =====
	local function updateHighlight(player)
		if player.Character and player.Character:FindFirstChild("ESPHighlight") and player.Character:FindFirstChild("Humanoid") then
			if player.Character.Humanoid.Health <= 0 then
				player.Character.ESPHighlight.FillColor = Color3.fromRGB(120, 0, 0)
			else
				player.Character.ESPHighlight.FillColor = Color3.fromRGB(255, 0, 0)
			end
		end
	end
	
	-- ===== НАСТРОЙКА ESP ДЛЯ ИГРОКА =====
	local function setupESP(player)
		if player ~= LocalPlayer then
			player.CharacterAdded:Connect(function()
				task.wait(0.1)
				if isEnabled then
					createHighlight(player)
					createNameTag(player)
				end
			end)
			if player.Character and isEnabled then
				createHighlight(player)
				createNameTag(player)
			end
		end
	end
	
	-- ===== ВКЛЮЧЕНИЕ ESP =====
	local function startESP()
		if isEnabled then return end
		isEnabled = true
		print("🟢 ESP включён!")
	
		-- Создаём ESP для всех игроков
		for _, player in ipairs(Players:GetPlayers()) do
			setupESP(player)
		end
	
		-- Запускаем обновление
		espLoop = RunService.Heartbeat:Connect(function()
			if not isEnabled then
				espLoop:Disconnect()
				espLoop = nil
				return
			end
	
			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= LocalPlayer then
					if player.Character and player.Character:FindFirstChild("Humanoid") then
						updateNameTag(player)
						updateHighlight(player)
					end
				end
			end
		end)
	end
	
	-- ===== ВЫКЛЮЧЕНИЕ ESP =====
	local function stopESP()
		isEnabled = false
		if espLoop then
			espLoop:Disconnect()
			espLoop = nil
		end
	
		-- Удаляем всё ESP
		for _, player in ipairs(Players:GetPlayers()) do
			if player.Character then
				local highlight = player.Character:FindFirstChild("ESPHighlight")
				if highlight then highlight:Destroy() end
				local head = player.Character:FindFirstChild("Head")
				if head then
					local tag = head:FindFirstChild("NameTag")
					if tag then tag:Destroy() end
				end
			end
		end
		print("🔴 ESP выключен!")
	end
	
	-- ===== КНОПКА =====
	button.MouseButton1Click:Connect(function()
		if isEnabled then
			stopESP()
		else
			startESP()
		end
	end)
	
	-- ===== НОВЫЕ ИГРОКИ =====
	Players.PlayerAdded:Connect(function(player)
		if isEnabled then
			task.wait(0.5)
			setupESP(player)
		end
	end)
	
	print("✅ ESP_Players загружен!")
end;
