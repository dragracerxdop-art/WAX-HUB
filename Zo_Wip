local function C_d()
local script = G2L["d"];
	-- ==========================================
	-- HBE_Toggle (БЕЗ CanCollide)
	-- ==========================================
	local button = script.Parent
	local player = game.Players.LocalPlayer
	local runService = game:GetService("RunService")
	
	local hitboxEnabled = false
	local hitboxSize = 5
	local hitboxLoop = nil
	_G.HitboxEnabled = false
	
	-- ===== ПОЛЕ ДЛЯ РАЗМЕРА =====
	local sizeBox = button:FindFirstChild("HBE_Size")
	if sizeBox then
		sizeBox.PlaceholderText = "1-7"
		sizeBox.Text = tostring(hitboxSize)
		sizeBox:GetPropertyChangedSignal("Text"):Connect(function()
			local val = tonumber(sizeBox.Text)
			if val then
				hitboxSize = math.clamp(val, 1, 7)
				sizeBox.Text = tostring(hitboxSize)
				if hitboxEnabled then applyHitbox() end
			end
		end)
	end
	
	-- ===== ПОИСК ОРУЖИЯ =====
	local function findWeaponParts()
		local parts = {}
		local char = player.Character
		if not char then return parts end
		for _, part in pairs(char:GetDescendants()) do
			if part:IsA("BasePart") or part:IsA("MeshPart") then
				local partName = part.Name:lower()
				local parentName = part.Parent and part.Parent.Name or ""
				if (partName == "blade" or partName == "handle") and parentName == "HandleSaved" then
					table.insert(parts, part)
				end
			end
		end
		return parts
	end
	
	-- ===== ПРИМЕНЕНИЕ (БЕЗ CanCollide) =====
	local function applyHitbox()
		local size = math.clamp(hitboxSize, 1, 7)
		local parts = findWeaponParts()
		for _, part in pairs(parts) do
			pcall(function()
				local originalSize = part:GetAttribute("OriginalSize")
				if not originalSize then
					part:SetAttribute("OriginalSize", part.Size)
					originalSize = part.Size
				end
				part.Size = originalSize * size
				-- ❌ УБРАЛ part.CanCollide = false
			end)
		end
	end
	
	-- ===== ВОССТАНОВЛЕНИЕ =====
	local function restoreHitbox()
		local parts = findWeaponParts()
		for _, part in pairs(parts) do
			pcall(function()
				local originalSize = part:GetAttribute("OriginalSize")
				if originalSize then
					part.Size = originalSize
				end
				part.Transparency = 0
				part.BrickColor = BrickColor.new("Medium stone grey")
				part.Material = Enum.Material.Plastic
			end)
		end
	end
	
	-- ===== ПЕРЕКЛЮЧЕНИЕ =====
	local function toggleHitbox()
		hitboxEnabled = not hitboxEnabled
		_G.HitboxEnabled = hitboxEnabled
		if hitboxEnabled then
			if hitboxLoop then hitboxLoop:Disconnect() end
			applyHitbox()
			hitboxLoop = runService.RenderStepped:Connect(function()
				if hitboxEnabled then applyHitbox() end
			end)
			print("🗡️ Хитбокс ВКЛ (размер: " .. hitboxSize .. "x)")
		else
			if hitboxLoop then hitboxLoop:Disconnect() hitboxLoop = nil end
			restoreHitbox()
			print("🗡️ Хитбокс ВЫКЛ")
		end
	end
	
	button.MouseButton1Click:Connect(toggleHitbox)
	
	player.CharacterAdded:Connect(function()
		task.wait(0.5)
		if hitboxEnabled then applyHitbox() end
	end)
	
	print("✅ HBE_Toggle (без CanCollide) загружен!")
end;
