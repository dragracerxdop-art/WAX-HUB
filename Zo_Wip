-- StarterGui.Zo_Gui.MainFrame.HBE_Visual.LocalScript
local function C_20()
local script = G2L["20"];
	-- ==========================================
	-- HBE_Visual (ВКЛ/ВЫКЛ ВИЗУАЛА)
	-- ==========================================
	local button = script.Parent
	local player = game.Players.LocalPlayer
	local runService = game:GetService("RunService")
	
	_G.HitboxVisible = false
	local visualLoop = nil
	
	-- ===== ПОИСК ОРУЖИЯ =====
	local function findWeaponParts()
		local parts = {}
		local char = player.Character
		if not char then return parts end
	
		for _, part in pairs(char:GetDescendants()) do
			if part:IsA("BasePart") or part:IsA("MeshPart") then
				local partName = part.Name:lower()
				local parentName = part.Parent and part.Parent.Name or ""
	
				if (partName == "blade" or partName == "handle") and parentName == "HandleSaved" then
					table.insert(parts, part)
				end
			end
		end
		return parts
	end
	
	-- ===== ПРИМЕНЕНИЕ ВИЗУАЛА =====
	local function applyVisual()
		local parts = findWeaponParts()
	
		for _, part in pairs(parts) do
			pcall(function()
				if _G.HitboxVisible and _G.HitboxEnabled then
					part.Transparency = 0.4
					part.Color = Color3.fromRGB(75, 0, 130)
					part.Material = Enum.Material.Neon
				elseif _G.HitboxEnabled then
					part.Transparency = 1
					part.Color = Color3.fromRGB(128, 128, 128)
					part.Material = Enum.Material.Plastic
				else
					part.Transparency = 0
					part.Color = Color3.fromRGB(128, 128, 128)
					part.Material = Enum.Material.Plastic
				end
			end)
		end
	end
	
	-- ===== ЗАПУСК ЦИКЛА =====
	local function startVisualLoop()
		if visualLoop then
			visualLoop:Disconnect()
			visualLoop = nil
		end
	
		visualLoop = runService.RenderStepped:Connect(function()
			applyVisual()
		end)
	end
	
	-- ===== ПЕРЕКЛЮЧЕНИЕ =====
	local function toggleVisible()
		_G.HitboxVisible = not _G.HitboxVisible
		applyVisual()
	
		if not visualLoop then
			startVisualLoop()
		end
	
		print(_G.HitboxVisible and "👁️ Хитбокс ВИДИМ" or "👁️ Хитбокс СКРЫТ")
	end
	
	button.MouseButton1Click:Connect(toggleVisible)
	
	player.CharacterAdded:Connect(function()
		task.wait(0.5)
		if _G.HitboxVisible then
			applyVisual()
		end
		if visualLoop then
			visualLoop:Disconnect()
			visualLoop = nil
		end
		startVisualLoop()
	end)
	
	startVisualLoop()
	
	print("✅ HBE_Visual загружен!")
end;
