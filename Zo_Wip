			strokeColor = Color3.fromRGB(0, 200, 150)
		},
		{
			name = "РАДУГА 🌈",
			textColor = nil,
			strokeColor = nil
		}
	}
	
	local currentTheme = 1
	
	-- ===== ФУНКЦИЯ ПРИМЕНЕНИЯ ТЕМЫ =====
	local function applyTheme(themeIndex)
		local theme = themes[themeIndex]
		if not theme then return end
	
		if rainbowActive then
			rainbowActive = false
			if rainbowConnection then
				rainbowConnection:Disconnect()
				rainbowConnection = nil
			end
		end
	
		-- ===== РАДУГА =====
		if theme.name == "РАДУГА 🌈" then
			rainbowActive = true
			print("🌈 РАДУГА АКТИВИРОВАНА!")
	
			local textObjects = {}
			local strokeObjects = {}
	
			local function collectObjects(parent)
				for _, child in pairs(parent:GetChildren()) do
					if child:IsA("TextButton") or child:IsA("TextLabel") or child:IsA("TextBox") then
						table.insert(textObjects, child)
					end
					if child:IsA("UIStroke") then
						table.insert(strokeObjects, child)
					end
					collectObjects(child)
				end
			end
	
			collectObjects(mainFrame)
	
			local hue = 0
			rainbowConnection = game:GetService("RunService").Heartbeat:Connect(function(dt)
				hue = (hue + dt * 0.3) % 1
	
				local color = Color3.fromHSV(hue, 1, 1)
	
				for _, obj in pairs(textObjects) do
					obj.TextColor3 = color
				end
	
				local strokeColor = Color3.fromHSV((hue + 0.5) % 1, 1, 0.7)
				for _, obj in pairs(strokeObjects) do
					obj.Color = strokeColor
				end
			end)
	
			print("✅ РАДУГА включена!")
			return
		end
	
		-- ===== ОБЫЧНЫЕ ЦВЕТА =====
		print("🎨 Применяем тему: " .. theme.name)
	
		local function applyToAll(parent)
			for _, child in pairs(parent:GetChildren()) do
				if child:IsA("TextButton") or child:IsA("TextLabel") or child:IsA("TextBox") then
					child.TextColor3 = theme.textColor
				end
	
				if child:IsA("UIStroke") then
					child.Color = theme.strokeColor
				end
	
				applyToAll(child)
			end
		end
	
		applyToAll(mainFrame)
		print("✅ Тема " .. theme.name .. " применена!")
	end
	
	-- ===== НАЖАТИЕ НА КНОПКУ =====
	button.MouseButton1Click:Connect(function()
		currentTheme = currentTheme + 1
		if currentTheme > #themes then
			currentTheme = 1
		end
		applyTheme(currentTheme)
	end)
	
	-- ===== СТАРТУЕМ С ПЕРВОЙ ТЕМОЙ =====
	applyTheme(1)
	print("✅ Скрипт смены тем загружен! (14 цветов + РАДУГА)")
end;
