local function C_10()
local script = G2L["10"];
	-- ==========================================
	-- HBE_Size (УСТАНОВКА РАЗМЕРА)
	-- ==========================================
	local textBox = script.Parent
	
	textBox.FocusLost:Connect(function(enterPressed)
		if not enterPressed then return end
	
		local value = tonumber(textBox.Text)
		if not value then
			textBox.Text = "1.0"
			return
		end
	
		-- Ограничение от 0 до 7
		value = math.clamp(value, 0, 7)
		textBox.Text = string.format("%.1f", value)
	
		if getgenv().HBE and getgenv().HBE.size then
			getgenv().HBE.size(value)
			print("📏 Размер хитбокса:", value)
		else
			warn("❌ HBE не загружен!")
		end
	end)
	
	print("✅ HBE_Size загружен!")
end;
