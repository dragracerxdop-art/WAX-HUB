local function C_d()
local script = G2L["d"];
	-- ==========================================
	-- СМЕНА ЦВЕТА (С РАДУГОЙ)
	-- ==========================================
	local button = script.Parent
	local mainFrame = button.Parent  -- MainFrame (там где лежат все кнопки)
	
	local rainbowActive = false
	local rainbowConnection = nil
	
	-- ===== ЦВЕТА =====
	local themes = {
		{ name = "Фиолетовый", textColor = Color3.fromRGB(180, 80, 255), strokeColor = Color3.fromRGB(130, 30, 200) },
		{ name = "Красный", textColor = Color3.fromRGB(255, 50, 50), strokeColor = Color3.fromRGB(200, 0, 0) },
		{ name = "Синий", textColor = Color3.fromRGB(50, 150, 255), strokeColor = Color3.fromRGB(0, 100, 200) },
		{ name = "Зеленый", textColor = Color3.fromRGB(50, 255, 50), strokeColor = Color3.fromRGB(0, 200, 0) },
		{ name = "Оранжевый", textColor = Color3.fromRGB(255, 150, 50), strokeColor = Color3.fromRGB(200, 100, 0) },
		{ name = "Желтый", textColor = Color3.fromRGB(255, 255, 50), strokeColor = Color3.fromRGB(200, 200, 0) },
		{ name = "Голубой", textColor = Color3.fromRGB(50, 255, 255), strokeColor = Color3.fromRGB(0, 200, 200) },
		{ name = "Розовый", textColor = Color3.fromRGB(255, 100, 200), strokeColor = Color3.fromRGB(200, 50, 150) },
		{ name = "Бирюзовый", textColor = Color3.fromRGB(50, 200, 200), strokeColor = Color3.fromRGB(0, 150, 150) },
		{ name = "Лайм", textColor = Color3.fromRGB(150, 255, 50), strokeColor = Color3.fromRGB(100, 200, 0) },
		{ name = "Коралловый", textColor = Color3.fromRGB(255, 100, 80), strokeColor = Color3.fromRGB(200, 50, 30) },
		{ name = "Белый", textColor = Color3.fromRGB(255, 255, 255), strokeColor = Color3.fromRGB(180, 180, 180) },
		{ name = "Серый", textColor = Color3.fromRGB(180, 180, 180), strokeColor = Color3.fromRGB(120, 120, 120) },
		{ name = "Неоновый", textColor = Color3.fromRGB(0, 255, 200), strokeColor = Color3.fromRGB(0, 200, 150) },
		{ name = "РАДУГА 🌈", textColor = nil, strokeColor = nil }
	}
	
	local currentTheme = 1
	
	-- ===== ПРИМЕНЕНИЕ ТЕМЫ =====
	local function applyTheme(themeIndex)
		local theme = themes[themeIndex]
		if not theme then return end
	
		-- Выключаем радугу, если она была
		if rainbowActive then
			rainbowActive = false
			if rainbowConnection then
				rainbowConnection:Disconnect()
				rainbowConnection = nil
			end
		end
	
		-- ===== РАДУГА =====
		if theme.name == "РАДУГА 🌈" then
			rainbowActive = true
			print("🌈 РАДУГА АКТИВИРОВАНА!")
	
			local textObjects = {}
			local strokeObjects = {}
	
			local function collectObjects(parent)
				for _, child in pairs(parent:GetChildren()) do
					if child:IsA("TextButton") or child:IsA("TextLabel") or child:IsA("TextBox") then
						table.insert(textObjects, child)
					end
					if child:IsA("UIStroke") then
						table.insert(strokeObjects, child)
					end
					collectObjects(child)
				end
			end
	
			collectObjects(mainFrame)
	
			local hue = 0
			rainbowConnection = game:GetService("RunService").Heartbeat:Connect(function(dt)
				hue = (hue + dt * 0.3) % 1
	
				local color = Color3.fromHSV(hue, 1, 1)
	
				for _, obj in pairs(textObjects) do
					obj.TextColor3 = color
				end
	
				local strokeColor = Color3.fromHSV((hue + 0.5) % 1, 1, 0.7)
				for _, obj in pairs(strokeObjects) do
					obj.Color = strokeColor
				end
			end)
	
			print("✅ РАДУГА включена!")
			return
		end
	
		-- ===== ОБЫЧНЫЕ ЦВЕТА =====
		print("🎨 Применяем тему: " .. theme.name)
	
		local function applyToAll(parent)
			for _, child in pairs(parent:GetChildren()) do
				if child:IsA("TextButton") or child:IsA("TextLabel") or child:IsA("TextBox") then
					child.TextColor3 = theme.textColor
				end
	
				if child:IsA("UIStroke") then
					child.Color = theme.strokeColor
				end
	
				applyToAll(child)
			end
		end
	
		applyToAll(mainFrame)
		print("✅ Тема " .. theme.name .. " применена!")
	end
	
	-- ===== НАЖАТИЕ НА КНОПКУ =====
	button.MouseButton1Click:Connect(function()
		currentTheme = currentTheme + 1
		if currentTheme > #themes then
			currentTheme = 1
		end
		applyTheme(currentTheme)
	end)
	
	-- ===== СТАРТУЕМ С ПЕРВОЙ ТЕМЫ =====
	applyTheme(1)
	print("✅ Settings_Color загружен!")
end;
