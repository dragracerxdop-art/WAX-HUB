local function C_6()
local script = G2L["6"];
	-- ==========================================
	-- ПЕРЕТАСКИВАНИЕ (ИСПРАВЛЕННОЕ)
	-- ==========================================
	local textLabel = script.Parent
	local frame = textLabel.Parent
	local uis = game:GetService("UserInputService")
	
	local dragging = false
	local dragStart = nil
	local startPos = nil
	local connection = nil
	
	local function startDrag(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
	
			if connection then
				connection:Disconnect()
				connection = nil
			end
	
			connection = uis.InputChanged:Connect(function(input)
				if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					local delta = input.Position - dragStart
					frame.Position = UDim2.new(
						startPos.X.Scale,
						startPos.X.Offset + delta.X,
						startPos.Y.Scale,
						startPos.Y.Offset + delta.Y
					)
				end
			end)
		end
	end
	
	local function endDrag(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
			if connection then
				connection:Disconnect()
				connection = nil
			end
		end
	end
	
	textLabel.InputBegan:Connect(startDrag)
	uis.InputEnded:Connect(endDrag)
	
	print("✅ Перетаскивание загружено")
end;
