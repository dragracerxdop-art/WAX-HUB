	local button = script.Parent
	local player = game.Players.LocalPlayer
	local UserInputService = game:GetService("UserInputService")
	
	local isListening = false
	local hideKey = nil
	local gui = button.Parent.Parent  -- Добираемся до ScreenGui (TeleportGui)
	
	-- ===== ТОГГЛ ГУЯ =====
	local function toggleGui()
		if not gui then return end
	
		-- Если это ScreenGui, используем Enabled. Если Frame - Visible.
		if gui:IsA("ScreenGui") then
			gui.Enabled = not gui.Enabled
			print("🔄 TeleportGui:", gui.Enabled and "открыт" or "скрыт")
		elseif gui:IsA("Frame") then
			gui.Visible = not gui.Visible
			print("🔄 TeleportGui:", gui.Visible and "открыт" or "скрыт")
		end
	end
	
	-- ===== НАЖАТИЕ НА КНОПКУ (НАЧАЛО ПРОСЛУШКИ ДЛЯ БИНДА) =====
	button.MouseButton1Click:Connect(function()
		if isListening then return end
	
		isListening = true
		print("⌨️ Нажми любую клавишу для установки бинда...")
	
		local connection
		connection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
			if gameProcessed then return end
			if input.UserInputType == Enum.UserInputType.Keyboard then
				hideKey = input.KeyCode
				isListening = false
				connection:Disconnect()
