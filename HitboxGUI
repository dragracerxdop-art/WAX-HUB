-- StarterGui.Hitbox_Gui.MainFrame.Hitbox_Toggle.LocalScript
local function C_d()
local script = G2L["d"];
	-- ==========================================
	-- HITBOX EXPANDER (КВАДРАТ + СКВОЗЬ СТЕНЫ)
	-- ==========================================
	local button = script.Parent
	local Players = game:GetService("Players")
	local player = Players.LocalPlayer
	local runService = game:GetService("RunService")
	
	local textBox = button:FindFirstChild("Hitbox_Size")
	local isEnabled = false
	local currentSize = 10
	local updateLoop = nil
	
	_G.HitboxVisible = false
	_G.HitboxEnabled = false
	
	-- Функция обновления квадрата
	local function updateHitboxes()
		for _, plr in pairs(Players:GetPlayers()) do
			if plr ~= player and plr.Character then
				local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
				local hitbox = plr.Character:FindFirstChild("CustomHitbox")
	
				if _G.HitboxEnabled and currentSize > 1 and hrp then
					-- Если квадрата нет, создаем
					if not hitbox then
						hitbox = Instance.new("Part")
						hitbox.Name = "CustomHitbox"
						hitbox.CanCollide = false -- Чтобы не откидывал
						hitbox.Massless = true
						hitbox.Parent = plr.Character
	
						local weld = Instance.new("WeldConstraint")
						weld.Part0 = hrp
						weld.Part1 = hitbox
						weld.Parent = hitbox
					end
	
					-- Настраиваем размер и позицию
					hitbox.Size = Vector3.new(currentSize, currentSize, currentSize)
					hitbox.CFrame = hrp.CFrame -- Привязка к игроку
	
					if _G.HitboxVisible then
						-- ОЧЕНЬ ПРОЗРАЧНЫЙ НЕОН (ВИДНО КАК ПРИЗРАК)
						hitbox.Transparency = 0.85 
						hitbox.Color = Color3.fromRGB(75, 0, 130)
						hitbox.Material = Enum.Material.Neon
						hitbox.CastShadow = false
					else
						-- ПОЛНОСТЬЮ НЕВИДИМЫЙ
						hitbox.Transparency = 1
						hitbox.Color = Color3.fromRGB(128, 128, 128)
						hitbox.Material = Enum.Material.Plastic
					end
				else
					-- Если выключено, удаляем
					if hitbox then hitbox:Destroy() end
				end
			end
		end
	end
	
	-- Клик по кнопке
	button.MouseButton1Click:Connect(function()
		isEnabled = not isEnabled
		_G.HitboxEnabled = isEnabled
	
		if isEnabled then
			if textBox then
				local val = tonumber(textBox.Text)
				currentSize = (val and val >= 0 and val <= 100) and val or 10
			end
			if updateLoop then updateLoop:Disconnect() end
			updateLoop = runService.RenderStepped:Connect(updateHitboxes)
			print("✅ Хитбокс ВКЛ, размер:", currentSize)
		else
			if updateLoop then updateLoop:Disconnect() updateLoop = nil end
			updateHitboxes()
			print("❌ Хитбокс ВЫКЛ")
		end
	end)
	
	-- Ввод в текстбокс
	if textBox then
		textBox.FocusLost:Connect(function(enterPressed)
			if enterPressed then
				local val = tonumber(textBox.Text)
				if val and val >= 0 and val <= 100 then
					currentSize = val
					if isEnabled then updateHitboxes() end
				end
			end
		end)
	end
	
	print("✅ Hitbox Expander (квадрат) загружен!")
end;
