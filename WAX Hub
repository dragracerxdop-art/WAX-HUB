local function C_e()
local script = G2L["e"];
	-- ==========================================
	-- Settings_BindHide (НАЗНАЧЕНИЕ БИНДА)
	-- ==========================================
	local button = script.Parent
	local player = game.Players.LocalPlayer
	local UserInputService = game:GetService("UserInputService")
	
	local isListening = false
	local hideKey = nil
	local gui = button.Parent.Parent  -- ПОДНИМАЕМСЯ К MAINFRAME
	
	-- ТОГГЛ ГУЯ
	local function toggleGui()
		if not gui then return end
		gui.Visible = not gui.Visible
	end
	
	-- НАЖАТИЕ НА КНОПКУ (НАЧАЛО ПРОСЛУШКИ)
	button.MouseButton1Click:Connect(function()
		if isListening then return end
	
		isListening = true
	
		local connection
		connection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
			if gameProcessed then return end
			if input.UserInputType == Enum.UserInputType.Keyboard then
				hideKey = input.KeyCode
				isListening = false
				connection:Disconnect()
				print("🔑 БИНД УСТАНОВЛЕН:", hideKey.Name)
			end
		end)
	end)
	
	-- ОБРАБОТКА НАЖАТИЯ КЛАВИШИ (ВЕЗДЕ)
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if hideKey and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == hideKey then
			toggleGui()
		end
	end)
	
	print("✅ Settings_BindHide ЗАГРУЖЕНА!")
end;
