	-- ==========================================
	
	local leftFrame = script.Parent  -- SwitchTabs находится в LeftFrame
	local mainFrame = leftFrame.Parent  -- MainFrame
	local rightFrame = mainFrame:FindFirstChild("RightFrame")  -- Ищем RightFrame
	
	if not rightFrame then
		warn("❌ RightFrame не найден!")
		return
	end
	
	-- Находим Home_Info в правой панели
	local homeInfo = rightFrame:FindFirstChild("Home_Info")
	if not homeInfo then
		warn("❌ Home_Info не найден в RightFrame!")
	end
	
	-- ===== ФУНКЦИЯ ПЕРЕКЛЮЧЕНИЯ =====
	local function switchTab(tabName)
		print("🔘 Переключение на: " .. tabName)
	
		-- Скрываем ВСЁ в RightFrame (кроме UIComponent)
		for _, child in pairs(rightFrame:GetChildren()) do
			if not child:IsA("UIComponent") then
				child.Visible = false
			end
		end
	
		-- Если выбрана вкладка HOME — показываем Home_Info
		if tabName == "Home" then
			if homeInfo then
				homeInfo.Visible = true
				print("✅ HOME показан")
			end
		else
			print("✅ " .. tabName .. " (пока пусто)")
		end
	end
	
	-- ===== ПОДКЛЮЧАЕМ ВСЕ КНОПКИ В LEFTFRAME =====
	for _, btn in pairs(leftFrame:GetChildren()) do
		if btn:IsA("TextButton") then
			btn.MouseButton1Click:Connect(function()
				switchTab(btn.Name)
			end)
		end
	end
	
	-- ===== СТАРТУЕМ С HOME =====
	switchTab("Home")
	print("✅ Переключение вкладок загружено!")
end;
task.spawn(C_29);

return G2L["1"], require;
