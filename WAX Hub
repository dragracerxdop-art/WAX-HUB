			print("✅ TROLL (пусто)")
		else
			print("❌ Неизвестная вкладка: " .. tabName)
		end
	end
	
	-- ===== ПОДКЛЮЧАЕМ КНОПКИ =====
	for _, btn in pairs(leftFrame:GetChildren()) do
		if btn:IsA("TextButton") then
			btn.MouseButton1Click:Connect(function()
				switchTab(btn.Name)
			end)
		end
	end
	
	-- ===== СТАРТУЕМ С HOME =====
	switchTab("Home")
	print("✅ Переключение вкладок загружено!")
end;
task.spawn(C_7f);

return G2L["1"], require;
