local function C_18()
local script = G2L["18"];
	-- ==========================================
	-- ПЕРЕТАСКИВАНИЕ (ТЯНЕТ ВЕСЬ MAINFRAME)
	-- ==========================================
	local textLabel = script.Parent  -- TextLabel (за который тянем)
	local frame = textLabel.Parent   -- MainFrame (который двигаем)
	
	local uis = game:GetService("UserInputService")
	
	local dragging = false
	local dragStart = nil
	local startPos = nil
	local connection = nil
	
	local function startDrag(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
	
			if connection then
				connection:Disconnect()
				connection = nil
			end
	
			connection = uis.InputChanged:Connect(function(input)
				if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
					local delta = input.Position - dragStart
					frame.Position = UDim2.new(
						startPos.X.Scale,
						startPos.X.Offset + delta.X,
						startPos.Y.Scale,
						startPos.Y.Offset + delta.Y
					)
				end
			end)
		end
	end
	
	local function endDrag(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
			if connection then
				connection:Disconnect()
				connection = nil
			end
		end
	end
	
	-- Вешаем на TextLabel (за который тянем)
	textLabel.InputBegan:Connect(startDrag)
	uis.InputEnded:Connect(endDrag)
	
	-- Для сенсорных экранов
	textLabel.TouchBegan:Connect(function(input)
		dragging = true
		dragStart = input.Position
		startPos = frame.Position
	end)
	
	textLabel.TouchMoved:Connect(function(input)
		if dragging then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
	
	textLabel.TouchEnded:Connect(function()
		dragging = false
	end)
	
	print("✅ Перетаскивание обновлено! Тянет MainFrame")
end;
task.spawn(C_18);
