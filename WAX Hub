	end
	
	print("✅ RightFrame найден!")
	
	-- ===== ФУНКЦИЯ ПЕРЕКЛЮЧЕНИЯ =====
	local function switchTab(tabName)
		print("🔘 Переключение на: " .. tabName)
	
		-- Скрываем ВСЁ в RightFrame (кроме UI объектов)
		for _, child in pairs(rightFrame:GetChildren()) do
			if not child:IsA("UIComponent") then
				child.Visible = false
				print("🔹 Скрыт: " .. child.Name)
			end
		end
	
		-- ===== HOME =====
		if tabName == "Home" then
			local homeInfo = rightFrame:FindFirstChild("Home_Info")
			if homeInfo then
				homeInfo.Visible = true
				print("✅ HOME показан")
			else
				warn("❌ Home_Info не найден!")
			end
	
			-- ===== SETTINGS =====
		elseif tabName == "Settings" then
			local settingsHide = rightFrame:FindFirstChild("Settings_Hide")
			if settingsHide then
				settingsHide.Visible = true
				print("✅ SETTINGS (Settings_Hide показан)")
			else
				warn("❌ Settings_Hide не найден!")
			end
	
