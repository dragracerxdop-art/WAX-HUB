-- StarterGui.ScreenGui.MainFrame.LeftFrame.SwitchTabs
local function C_25()
local script = G2L["25"];
	-- ==========================================
	-- ПЕРЕКЛЮЧЕНИЕ ВКЛАДОК (ИСПРАВЛЕННЫЙ)
	-- ==========================================
	local leftFrame = script.Parent
	local mainFrame = leftFrame.Parent  -- MainFrame (родитель LeftFrame)
	local rightFrame = mainFrame:FindFirstChild("RightFrame")  -- Ищем RightFrame внутри MainFrame
	
	if not rightFrame then
		warn("❌ RightFrame не найден!")
		return
	end
	
	-- Находим Home_Info
	local homeInfo = rightFrame:FindFirstChild("Home_Info")
	
	-- ===== ФУНКЦИЯ ПЕРЕКЛЮЧЕНИЯ =====
	local function switchTab(tabName)
		print("🔘 Переключение на: " .. tabName)
	
		-- Скрываем ВСЁ в RightFrame (кроме UI объектов)
		for _, child in pairs(rightFrame:GetChildren()) do
			if not child:IsA("UIComponent") then
				child.Visible = false
			end
		end
	
		-- ===== HOME =====
		if tabName == "Home" then
			if homeInfo then
				homeInfo.Visible = true
			end
			print("✅ HOME показан")
	
			-- ===== ДРУГИЕ ВКЛАДКИ =====
		elseif tabName == "Games" then
			print("✅ GAMES (пусто)")
		elseif tabName == "Universal Scripts" then
			print("✅ UNIVERSAL SCRIPTS (пусто)")
		elseif tabName == "Troll" then
			print("✅ TROLL (пусто)")
		elseif tabName == "Universal" then
			print("✅ UNIVERSAL (пусто)")
		elseif tabName == "Settings" then
			print("✅ SETTINGS (пусто)")
		else
			print("❌ Неизвестная вкладка: " .. tabName)
		end
	end
	
	-- ===== ПОДКЛЮЧАЕМ КНОПКИ =====
	for _, btn in pairs(leftFrame:GetChildren()) do
		if btn:IsA("TextButton") then
			btn.MouseButton1Click:Connect(function()
				switchTab(btn.Name)
			end)
		end
	end
	
	-- ===== СТАРТУЕМ С HOME =====
	switchTab("Home")
	print("✅ Переключение вкладок загружено!")
end;
task.spawn(C_25);

