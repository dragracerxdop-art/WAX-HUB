local function C_28()
local script = G2L["28"];
	-- ==========================================
	-- СПИСОК ИГРОКОВ (БЕЗ ПУСТЫХ КВАДРАТОВ)
	-- ==========================================
	local Players = game:GetService("Players")
	local player = Players.LocalPlayer
	
	local container = script.Parent
	local template = container:FindFirstChild("PlayerTemplate")
	
	if not template then
		warn("❌ PlayerTemplate не найден!")
		return
	end
	
	template.Visible = false
	
	local selectedPlayers = {}
	local selectedIds = {}
	
	local function updateList()
		for _, child in pairs(container:GetChildren()) do
			if child ~= template then
				child:Destroy()
			end
		end
	
		selectedPlayers = {}
		for _, id in pairs(selectedIds) do
			local plr = Players:GetPlayerByUserId(id)
			if plr then
				table.insert(selectedPlayers, plr)
			end
		end
	
		local y = 0
		for _, plr in pairs(Players:GetPlayers()) do
			if plr ~= player then
				local new = template:Clone()
				new.Visible = true
				new.Position = UDim2.new(0, 0, 0, y)
				new.Parent = container
	
				local avatar = new:FindFirstChild("Avatar")
				local nameLabel = new:FindFirstChild("Name")
				local selectBtn = new:FindFirstChild("SelectBtn")
	
				if avatar then
					avatar.Image = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. plr.UserId .. "&width=100&height=100&format=png"
				end
	
				if nameLabel then
					nameLabel.Text = plr.Name
				end
	
				if selectBtn then
					-- Проверяем, выбран ли игрок
					local isSelected = false
					for _, id in pairs(selectedIds) do
						if id == plr.UserId then
							isSelected = true
							break
						end
					end
	
					-- ТЕКСТ: пусто или крестик
					if isSelected then
						selectBtn.Text = "✖"
						selectBtn.TextColor3 = Color3.fromRGB(255, 0, 0)  -- красный
					else
						selectBtn.Text = ""   -- пусто
						selectBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
					end
	
					selectBtn.MouseButton1Click:Connect(function()
						isSelected = not isSelected
	
						if isSelected then
							table.insert(selectedPlayers, plr)
							table.insert(selectedIds, plr.UserId)
							selectBtn.Text = "✖"
							selectBtn.TextColor3 = Color3.fromRGB(255, 0, 0)
							print("✅ Выбран:", plr.Name)
						else
							for i, p in ipairs(selectedPlayers) do
								if p == plr then
									table.remove(selectedPlayers, i)
									break
								end
							end
							for i, id in ipairs(selectedIds) do
								if id == plr.UserId then
									table.remove(selectedIds, i)
									break
								end
							end
							selectBtn.Text = ""
							print("❌ Отменён:", plr.Name)
						end
					end)
				end
	
				y = y + 47
			end
		end
	
		container.CanvasSize = UDim2.new(0, 0, 0, y + 10)
	end
	
	_G.GetSelectedPlayers = function()
		return selectedPlayers
	end
	
	Players.PlayerAdded:Connect(function()
		task.wait(0.5)
		updateList()
	end)
	
	Players.PlayerRemoving:Connect(function()
		updateList()
	end)
	
	updateList()
	
	print("✅ Список игроков загружен (без пустых квадратов)!")
end;
