	local themes = {
		{ name = "Фиолетовый", textColor = Color3.fromRGB(180, 80, 255), strokeColor = Color3.fromRGB(130, 30, 200) },
		{ name = "Красный", textColor = Color3.fromRGB(255, 50, 50), strokeColor = Color3.fromRGB(200, 0, 0) },
