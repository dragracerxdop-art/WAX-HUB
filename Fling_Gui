local function C_d()
local script = G2L["d"];
	-- ==========================================
	-- FLING START
	-- ==========================================
	local player = game.Players.LocalPlayer
	local RunService = game:GetService("RunService")
	
	local FlingActive = false
	local flingLoop = nil
	local queue = {}
	local currentIndex = 1
	
	local FLING_POWER = 9e7
	
	-- ===== ФЛИНГ ОДНОГО ИГРОКА =====
	local function flingTarget(target)
		local char = player.Character
		if not char then return false end
	
		local hrp = char:FindFirstChild("HumanoidRootPart")
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if not hrp or not humanoid then return false end
	
		local tChar = target.Character
		if not tChar then return false end
	
		local tHrp = tChar:FindFirstChild("HumanoidRootPart")
		local tHumanoid = tChar:FindFirstChildOfClass("Humanoid")
		if not tHrp or not tHumanoid or tHumanoid.Health <= 0 then return false end
	
		-- Сохраняем позицию игрока
		local savedPos = hrp.CFrame
	
		-- Телепортируемся к жертве
		hrp.CFrame = tHrp.CFrame * CFrame.new(0, 2, 3)
	
		-- Выкидываем жертву
		local bv = Instance.new("BodyVelocity")
		bv.Parent = tHrp
		bv.MaxForce = Vector3.new(1/0, 1/0, 1/0)
		bv.Velocity = Vector3.new(FLING_POWER, FLING_POWER * 2, FLING_POWER)
	
		-- Ждём 0.3 секунды
		task.wait(0.3)
	
		-- Удаляем BodyVelocity
		bv:Destroy()
	
		-- Возвращаем игрока на место
		hrp.CFrame = savedPos
	
		print("✅ Флинг завершён для:", target.Name)
		return true
	end
	
	-- ===== ЗАПУСК ФЛИНГА =====
	local function StartFling()
		if FlingActive then
			print("⚠️ Флинг уже запущен!")
			return
		end
	
		local selected = _G.GetSelectedPlayers and _G.GetSelectedPlayers() or {}
	
		if #selected == 0 then
			print("❌ Нет выбранных игроков!")
			return
		end
	
		FlingActive = true
		queue = {}
		for _, plr in pairs(selected) do
			table.insert(queue, plr)
		end
		currentIndex = 1
	
		print("🚀 Флинг запущен! Игроков:", #queue)
	
		flingLoop = RunService.Heartbeat:Connect(function()
			if not FlingActive then
				flingLoop:Disconnect()
				flingLoop = nil
				print("🔴 Флинг остановлен")
				return
			end
	
			if currentIndex > #queue then
				currentIndex = 1
			end
	
			local target = queue[currentIndex]
			if target and target.Character and target.Character:FindFirstChildOfClass("Humanoid") then
				flingTarget(target)
			else
				-- Удаляем мёртвого или вышедшего игрока
				table.remove(queue, currentIndex)
				if #queue == 0 then
					FlingActive = false
					if flingLoop then
						flingLoop:Disconnect()
						flingLoop = nil
					end
					print("⚠️ Все игроки недоступны!")
					return
				end
				if currentIndex > #queue then
					currentIndex = 1
				end
			end
	
			currentIndex = currentIndex + 1
			if currentIndex > #queue then
				currentIndex = 1
			end
		end)
	end
	
